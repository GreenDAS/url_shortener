# ----------------------------------------------------------------------------
# Author: Daniel S.
# Date: 11/10/2026
# File: .env.example
# Version: V1.0
# Description: Template for the real .env file. Copy this to ".env" and fill in
#              the passwords. The real .env is never committed (see .gitignore).
#              Rebuild the image after any change: docker compose up --build (DB-5)
# ----------------------------------------------------------------------------

# Database Connectivity
# host.docker.internal reaches the host from inside the app container (DB-2).
# The MySQL container publishes 3307 on the host so it does not clash with the
# Oracle MySQL install on 3306. This also works for "flask run" on Windows,
# since Docker Desktop adds host.docker.internal to the Windows hosts file.
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3307
MYSQL_USER=url_shortener
MYSQL_PASSWORD=change_me
MYSQL_DB=url_shortener

# Only used by the MySQL container the first time it creates its data volume
MYSQL_ROOT_PASSWORD=change_me_too

# Flask session signing key, use any long random string
SECRET_KEY=change_me_to_a_long_random_string
