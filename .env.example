# ----------------------------------------------------------------------------
# Author: Daniel S.
# Date: 11/11/2026
# File: .env.example
# Version: V1.2
# Description: Template for the real .env file. Copy this to ".env" and fill in
#              the passwords. The real .env is never committed (see .gitignore).
#              Rebuild the image after any change: docker compose up --build (DB-5)
#
#              Who reads these: app/config.py (MYSQL_*, SECRET_KEY) when the
#              app starts. MySQL itself runs on the host laptop (DB-1), so
#              MYSQL_USER and MYSQL_PASSWORD must match the user created
#              there (steps in docs/specs/host-mysql.md). Format is
#              NAME=value, no quotes or spaces around "=".
#              Spec sheet: docs/specs/app-startup.md
# ----------------------------------------------------------------------------

# Database Connectivity
# host.docker.internal reaches the host from inside the app container (DB-2).
# 3306 is the port the MySQL install on the laptop listens on. For "flask run"
# on Windows, if host.docker.internal times out, set the host for that one
# terminal instead: $env:MYSQL_HOST="127.0.0.1"
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_USER=url_shortener
MYSQL_PASSWORD=change_me
MYSQL_DB=url_shortener

# Flask session signing key, use any long random string
SECRET_KEY=change_me_to_a_long_random_string
