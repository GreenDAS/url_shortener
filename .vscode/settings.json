// ----------------------------------------------------------------------------
// Author: Daniel S.
// Date: 11/11/2026
// File: .vscode/settings.json
// Version: V1.1
// Description: VS Code workspace settings. Turns on the Testing panel using
//              Python's built in unittest (not pytest), looking in ./tests for
//              files named test_*.py. VS Code allows // comments in this file.
// ----------------------------------------------------------------------------
{
    "python.testing.unittestArgs": [
        "-v",             // Verbose: One Line Per Test
        "-s",
        "./tests",        // Start Folder To Search For Tests
        "-p",
        "test_*.py"       // File Name Pattern For Test Files
    ],
    "python.testing.pytestEnabled": false,
    "python.testing.unittestEnabled": true
}
